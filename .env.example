# DeepSeek（OpenAI 兼容接口）。申请 Key: https://platform.deepseek.com
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-chat

DASHSCOPE_API_KEY=your_dashscope_api_key
EMBED_MODEL_NAME=qwen3.7-text-embedding-flash

MILVUS_URL=http://127.0.0.1:19530
DB_NAME=RAG_DB
COL_NAME=RAG_DOCS

# 本地直跑 MCP/后端时访问宿主机 Java 的地址（容器化部署时由 docker-compose 覆盖为 http://java:8080）
JAVA_API_BASE_URL=http://127.0.0.1:8080
JAVA_API_TIMEOUT=10
JAVA_API_TOKEN=

# compose 内 MySQL（shop_db）初始化账号，Java 容器用同款账号连接 mysql:3306
MYSQL_ROOT_PASSWORD=123456
MYSQL_USER=shopmind
MYSQL_PASSWORD=shopmind_pwd

DATA_MODE=demo
RAG_MODE=local
MEMORY_MODE=auto

SHOPMIND_MCP_URL=http://127.0.0.1:8010/mcp
SHOPMIND_MCP_TIMEOUT=30
SHOPMIND_MCP_SSE_READ_TIMEOUT=300
SHOPMIND_MCP_TRANSPORT=streamable-http
SHOPMIND_MCP_HOST=127.0.0.1
SHOPMIND_MCP_PORT=8010
SHOPMIND_MCP_PATH=/mcp

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TIMEOUT=1
REDIS_MCP_CALL_LOG_ENABLED=true
REDIS_MCP_CALL_LOG_KEY=shopmind:v1:mcp:call_logs
REDIS_MCP_CALL_LOG_LIMIT=200
REDIS_MCP_CALL_LOG_TTL=604800

POSTGRES_URI=postgresql://customer_agent:customer_agent_pwd@127.0.0.1:5432/customer_agent_memory?sslmode=disable
